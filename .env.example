# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in the values for your environment.
#
# NOTE: When running the app via `docker compose up`, the docker-compose.yml
# `environment:` block overrides localhost URLs with Docker network hostnames
# (fuseki, postgres, redis, elasticsearch, rdf-delta).
# The values below are for local (non-containerised) development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application / Core
# -----------------------------------------------------------------------------

# The environment in which the application is running.
# Required | Allowed values: development, production, test
NODE_ENV=development

# The port used by the NestJS config system (overrides PORT if both are set).
# Optional | Default: 3000 | Range: 1-65535
API_PORT=3000

# The global prefix prepended to all API routes (e.g. /api/...).
# Optional | Default: api
API_PREFIX=api

# -----------------------------------------------------------------------------
# Fuseki (SPARQL triplestore)
# -----------------------------------------------------------------------------

# The URL of the Fuseki SPARQL endpoint to query against.
# Required
FUSEKI_ENDPOINT=http://localhost:3030/eden

# The URL of the RDF Delta Patch Log Server.
# Required
RDF_DELTA_URL=http://localhost:1066

# The RDF Delta datasource name to monitor.
# Required
RDF_DELTA_DATASOURCE=eden

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------

# The URL of the Elasticsearch instance to index documents into.
# Required
ELASTICSEARCH_URL=http://localhost:9200

# The Elasticsearch index alias the application targets.
# Required
ELASTICSEARCH_ALIAS=eden

# The Elasticsearch username for authenticated clusters.
# Optional | Not set for local development
# ELASTICSEARCH_USERNAME=

# The Elasticsearch password for authenticated clusters.
# Optional | Not set for local development
# ELASTICSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL (Prisma)
# -----------------------------------------------------------------------------

# The PostgreSQL connection string used by Prisma ORM.
# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eden_exporter

# -----------------------------------------------------------------------------
# Redis (Bull queue)
# -----------------------------------------------------------------------------

# The hostname of the Redis instance used by Bull for job queuing.
# Optional | Default: localhost
REDIS_HOST=localhost

# The port of the Redis instance.
# Optional | Default: 6379
REDIS_PORT=6379

# The password for the Redis instance.
# Optional | Not set for local development
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# The API token required to authorize requests.
# Required | Minimum 32 characters
AUTH_API_TOKEN=CHANGE-ME-set-a-real-token-here!
