# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Application / Core
# -----------------------------------------------------------------------------

# The environment in which the application is running.
# Required | Allowed values: development, production, test
NODE_ENV=development

# The port the HTTP server listens on.
# Optional | Default: 3000
PORT=3000

# The port used by the NestJS config system (overrides PORT if both are set).
# Optional | Default: 3000 | Range: 1-65535
API_PORT=3000

# The global prefix prepended to all API routes (e.g. /api/...).
# Optional | Default: api
API_PREFIX=api
